// 売り場バトン:データの形
// 設計の理由は docs/03_DB設計.md にまとめている。
// Prisma で書けない制約(CHECK・行レベルセキュリティ)は
// prisma/migrations の SQL に手で足している。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// スタッフの役割。イベントスタッフの記録には印をつける
enum StaffRole {
  REGULAR // 常勤
  EVENT // イベントスタッフ

  @@map("staff_role")
}

/// 記録の出どころ。画面の「記録にかかった時間」は MANUAL(人が画面で入れた分)だけで集計する
enum VisitSource {
  MANUAL // 人が画面で入れた
  SEED // 見本データ(作り物)
  E2E // 自動テストが画面で入れた
  UNKNOWN // この列ができる前からあった記録(出どころ不明。集計に入れない)

  @@map("visit_source")
}

/// お客様の温度感(4段階のどれか1つ)
enum Temperature {
  POSITIVE // 前向き
  CONSIDERING // 検討中
  COMPARING // 他社と比較中
  NOT_NOW // 今回は見送り

  @@map("temperature")
}

/// 次にやることの種類。OTHER のときだけ自由記入が必須
enum NextActionKind {
  QUOTE // 見積もりを渡す
  FAMILY // 家族と相談
  DOCUMENTS // 書類を持って再来店
  STOCK // 入荷・在庫の連絡
  CALLBACK // こちらから連絡
  OTHER // その他(自由記入)

  @@map("next_action_kind")
}

model Store {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  staff     Staff[]
  customers Customer[]

  @@map("stores")
}

model Staff {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  name      String    @db.VarChar(50)
  role      StaffRole
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  store            Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  visits           Visit[]
  completedActions NextAction[] @relation("CompletedBy")

  // 名前の一意制約は付けない(同じ名前のスタッフはありうる。画面では役割とIDで見分ける)
  @@map("staff")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    Int      @map("store_id")
  /// 全角カタカナに揃えて保存する(ひらがな・半角で入れても同じ人が探せるように)
  nameKana   String   @map("name_kana") @db.VarChar(60)
  /// 電話番号は下4桁だけ持つ(個人情報を最小限にする)
  phoneLast4 String   @map("phone_last4") @db.Char(4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  visits Visit[]

  // 検索は「下4桁で絞る → カナで確かめる」の順が一番多いので、この並び
  @@index([storeId, phoneLast4, nameKana])
  // カナだけの前方一致(LIKE 'カト%')用。実際のDBでは varchar_pattern_ops 付きで作っている
  // (migrations/20261006120037_kana_prefix_index)。Prisma 7.10 はスキーマに ops を書くと
  // 毎回この索引を作り直すマイグレーションを出すため、スキーマ側は素の形で書いている
  @@index([storeId, nameKana])
  @@map("customers")
}

/// 接客記録(1回の来店で1件)
model Visit {
  id                 String      @id @default(uuid()) @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  /// 案内した人。NOT NULL なので「誰が案内したか」は必ず残る
  staffId            Int         @map("staff_id")
  /// 記録した時点の役割。後で常勤になっても、過去の記録の「イベント」の印と集計は変わらない
  staffRoleAtVisit   StaffRole   @map("staff_role_at_visit")
  /// 記録の出どころ(見本・自動テスト・人)
  source             VisitSource @default(MANUAL)
  /// 記録画面を開いたときに発行する送信ID。同じIDの再送は1件にまとめる(二重送信の防止)
  requestId          String      @unique @default(dbgenerated("gen_random_uuid()")) @map("request_id") @db.Uuid
  /// 送った内容の指紋(SHA-256)。同じ送信IDで中身が違う再送を見分ける。この列より前の記録は空
  requestFingerprint String?     @map("request_fingerprint") @db.Char(64)
  visitedAt          DateTime    @default(now()) @map("visited_at") @db.Timestamptz(3)
  temperature        Temperature
  memo               String?     @db.VarChar(500)
  /// 最初の入力から保存までの秒数。測れなかったときは空(集計に入れない)
  inputSeconds       Int?        @map("input_seconds")
  nextVisitDate      DateTime?   @map("next_visit_date") @db.Date
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff       Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  topics      VisitTopic[]
  nextActions NextAction[]

  // お客様カードの時系列(新しい順)
  @@index([customerId, visitedAt(sort: Desc)])
  // 今日・今週の来店予定
  @@index([nextVisitDate])
  @@index([staffId])
  @@map("visits")
}

/// 用件の目録(機種変更・のりかえ など)
model Topic {
  id        Int    @id @default(autoincrement())
  code      String @unique @db.VarChar(30)
  label     String @db.VarChar(30)
  sortOrder Int    @map("sort_order")

  checklistItems ChecklistItem[]
  visitTopics    VisitTopic[]

  @@map("topics")
}

/// 用件ごとの「案内すること」の目録
model ChecklistItem {
  id               Int       @id @default(autoincrement())
  topicId          Int       @map("topic_id")
  label            String    @db.VarChar(40)
  sortOrder        Int       @map("sort_order")
  /// 料金・キャンペーンのように、時期によって中身が変わる項目か
  isVolatile       Boolean   @default(false) @map("is_volatile")
  /// 最後に中身が変わった日(店長が入れる想定。この版は seed で入れる)。
  /// この日より前に説明していたら「変更あり:必ず案内」にする
  contentRevisedOn DateTime? @map("content_revised_on") @db.Date
  /// 中身の版。中身が変わるたびに1つ上げる。説明したときの版と比べて「変更あり」を決める
  contentVersion   Int       @default(1) @map("content_version")

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  visitChecks VisitCheck[]

  @@unique([topicId, label])
  // visit_checks から (id, topic_id) の組で参照するための一意制約
  @@unique([id, topicId])
  @@map("checklist_items")
}

/// 記録と用件の中間表(1回の来店で用件は複数選べる)
model VisitTopic {
  visitId String @map("visit_id") @db.Uuid
  topicId Int    @map("topic_id")

  visit  Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  topic  Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  checks VisitCheck[]

  @@id([visitId, topicId])
  @@index([topicId])
  @@map("visit_topics")
}

/// 記録と「案内したこと」の中間表
/// (visit_id, topic_id) を visit_topics に、(checklist_item_id, topic_id) を checklist_items に
/// つないでいるので「選んでいない用件の項目にチェックがつく」ことをDBが止める
model VisitCheck {
  visitId              String  @map("visit_id") @db.Uuid
  topicId              Int     @map("topic_id")
  checklistItemId      Int     @map("checklist_item_id")
  /// 案内したが、お客様の理解があいまいだった(任意の印。次の人はもう一度詳しく案内する)
  understandingUnclear Boolean @default(false) @map("understanding_unclear")
  /// 説明したときの、その項目の中身の版(checklist_items.content_version)
  explainedVersion     Int     @map("explained_version")

  visitTopic    VisitTopic    @relation(fields: [visitId, topicId], references: [visitId, topicId], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId, topicId], references: [id, topicId], onDelete: Restrict)

  @@id([visitId, checklistItemId])
  @@index([checklistItemId, topicId])
  @@map("visit_checks")
}

/// 次にやること(1件の記録に複数)。done_at が空なら未完了
model NextAction {
  id            String         @id @default(uuid()) @db.Uuid
  visitId       String         @map("visit_id") @db.Uuid
  kind          NextActionKind
  /// OTHER のときの自由記入(CHECK 制約で必須にしている)
  note          String?        @db.VarChar(100)
  doneAt        DateTime?      @map("done_at") @db.Timestamptz(3)
  doneByStaffId Int?           @map("done_by_staff_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  visit  Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doneBy Staff? @relation("CompletedBy", fields: [doneByStaffId], references: [id], onDelete: Restrict)

  @@index([visitId])
  // 「終わっていない次にやること」の一覧用
  @@index([doneAt])
  @@map("next_actions")
}
